# Local frontend configuration. Copy to .env and replace the placeholder values.

VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Optional. Human-readable price shown on the Subscription page, e.g. "$12 / month".
# Stripe owns the real amount; leave unset to point users to the secure checkout.
# VITE_STRIPE_PRICE_LABEL=

# Frontend calls the backend directly. Do not use a local or Cloudflare proxy.
VITE_API_BASE_URL=http://localhost:8000
